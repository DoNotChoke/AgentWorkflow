{
  "schema_version": "2.0",
  "nodes": [
    {
      "id": "t",
      "type": "trigger",
      "trigger": "manual",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ten_trang"
        ],
        "properties": {
          "ten_trang": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "id": "tim",
      "type": "tool",
      "tool_id": "notion.search",
      "tool_version": "1.2",
      "input": {
        "query": {
          "from_input": "ten_trang"
        }
      }
    },
    {
      "id": "khoi",
      "type": "tool",
      "tool_id": "notion.get_block_children",
      "tool_version": "1.0",
      "input": {
        "block_id": {
          "from_node": {
            "node": "tim",
            "path": [
              "results",
              "0",
              "id"
            ]
          }
        }
      }
    },
    {
      "id": "kenh",
      "type": "tool",
      "tool_id": "slack.list_channels",
      "tool_version": "1.0",
      "input": {}
    },
    {
      "id": "moi_cau",
      "type": "loop",
      "over": {
        "from_node": {
          "node": "khoi",
          "path": [
            "results"
          ]
        }
      },
      "filter": {
        "type": {
          "const": "numbered_list_item"
        }
      },
      "max_items": 50,
      "body": [
        {
          "id": "doc_khoi",
          "type": "tool",
          "tool_id": "notion.get_block_children",
          "tool_version": "1.0",
          "input": {
            "block_id": {
              "from_item": [
                "id"
              ]
            }
          }
        },
        {
          "id": "doc_dap_an",
          "type": "tool",
          "tool_id": "notion.get_block_children",
          "tool_version": "1.0",
          "input": {
            "block_id": {
              "from_node": {
                "node": "doc_khoi",
                "path": [
                  "results"
                ],
                "where": {
                  "type": {
                    "const": "toggle"
                  }
                },
                "pick": [
                  "id"
                ]
              }
            }
          }
        },
        {
          "id": "soan_cau_hoi",
          "type": "llm",
          "model": "claude-sonnet-5",
          "instructions": "Từ các khối trong `khoi` của một câu hỏi trắc nghiệm, viết lại đề bài và các lựa chọn thành một tin nhắn Slack. Không kèm đáp án.",
          "input": {
            "khoi": {
              "from_node": {
                "node": "doc_khoi",
                "path": [
                  "results"
                ]
              }
            }
          },
          "output_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        {
          "id": "dang_cau_hoi",
          "type": "tool",
          "tool_id": "slack.post_message",
          "tool_version": "1.0",
          "input": {
            "text": {
              "from_node": {
                "node": "soan_cau_hoi",
                "path": [
                  "text"
                ]
              }
            },
            "channel": {
              "from_node": {
                "node": "kenh",
                "path": [
                  "channels"
                ],
                "where": {
                  "name": {
                    "const": "aws"
                  }
                },
                "pick": [
                  "id"
                ]
              }
            }
          }
        },
        {
          "id": "soan_dap_an",
          "type": "llm",
          "model": "claude-sonnet-5",
          "instructions": "Từ các khối trong `dap_an`, viết một tin nhắn nêu đáp án đúng, bắt đầu bằng \"✅ Đáp án đúng:\".",
          "input": {
            "dap_an": {
              "from_node": {
                "node": "doc_dap_an",
                "path": [
                  "results"
                ]
              }
            }
          },
          "output_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        {
          "id": "tra_loi",
          "type": "tool",
          "tool_id": "slack.post_message",
          "tool_version": "1.0",
          "input": {
            "text": {
              "from_node": {
                "node": "soan_dap_an",
                "path": [
                  "text"
                ]
              }
            },
            "channel": {
              "from_node": {
                "node": "kenh",
                "path": [
                  "channels"
                ],
                "where": {
                  "name": {
                    "const": "aws"
                  }
                },
                "pick": [
                  "id"
                ]
              }
            },
            "thread_ts": {
              "from_node": {
                "node": "dang_cau_hoi",
                "path": [
                  "message_ts"
                ]
              }
            }
          }
        }
      ],
      "collect": "tra_loi"
    }
  ],
  "edges": [
    {
      "from": "t",
      "to": "tim"
    },
    {
      "from": "tim",
      "to": "khoi"
    },
    {
      "from": "khoi",
      "to": "kenh"
    },
    {
      "from": "kenh",
      "to": "moi_cau"
    }
  ]
}
