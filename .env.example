# AgentWorkflow — biến môi trường
#
#     cp .env.example .env
#
# KHÔNG commit file .env. Không đặt credential thật của provider vào đây —
# credential provider được lưu mã hoá trong PostgreSQL qua envelope encryption
# và do Connection domain sở hữu (§21).

# ─── Chung ───────────────────────────────────────────────────────────────────
AW_ENVIRONMENT=local
AW_DEBUG=true
AW_SERVICE_NAME=agentworkflow-api

# ─── PostgreSQL (§4.5) ───────────────────────────────────────────────────────
AW_DATABASE_URL=postgresql+asyncpg://agentworkflow:agentworkflow@localhost:5432/agentworkflow
AW_DATABASE_POOL_SIZE=10
AW_DATABASE_MAX_OVERFLOW=5
AW_DATABASE_ECHO=false

# ─── Redis — chỉ state phù du (§4.6) ─────────────────────────────────────────
AW_REDIS_URL=redis://localhost:6379/0
AW_REDIS_MAX_CONNECTIONS=20
# Timeout ngắn là cố ý: Redis treo phải hỏng nhanh, không kéo theo cả tiến trình.
AW_REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# ─── Object storage (§4.7) ───────────────────────────────────────────────────
AW_S3_ENDPOINT_URL=http://localhost:9000
AW_S3_REGION=us-east-1
AW_S3_ACCESS_KEY_ID=minio
AW_S3_SECRET_ACCESS_KEY=minio123
AW_S3_BUCKET_TRACES=aw-traces
AW_S3_BUCKET_ATTACHMENTS=aw-attachments
AW_S3_BUCKET_ARTIFACTS=aw-artifacts

# ─── Temporal (§4.4) ─────────────────────────────────────────────────────────
AW_TEMPORAL_HOST=localhost:7233
AW_TEMPORAL_NAMESPACE=default
# Task queue phản ánh NĂNG LỰC thực thi, không phản ánh provider (§14.1).
AW_TEMPORAL_TASK_QUEUE_INTEGRATION_READ=integration-read
AW_TEMPORAL_TASK_QUEUE_INTEGRATION_WRITE=integration-write
AW_TEMPORAL_TASK_QUEUE_AI=ai-tasks
AW_TEMPORAL_TASK_QUEUE_PROCESSING=data-processing

# ─── Observability (§4.10) ───────────────────────────────────────────────────
AW_OTEL_ENABLED=true
AW_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
AW_LOG_LEVEL=INFO
AW_LOG_JSON=true

# ─── Bảo mật ─────────────────────────────────────────────────────────────────
# Khoá ký JWT phiên làm việc. Sinh khoá mới:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ở production khoá phải dài ít nhất 32 byte (RFC 7518 §3.2) — ngắn hơn thì
# assert_production_safe() chặn boot.
AW_JWT_SECRET=thay-doi-truoc-khi-dung-that
# Chỉ chấp nhận HS256 / HS384 / HS512 vì AW_JWT_SECRET là khoá đối xứng.
AW_JWT_ALGORITHM=HS256
AW_JWT_ISSUER=agentworkflow
AW_ACCESS_TOKEN_TTL_SECONDS=3600
# Trần tuyệt đối của một chuỗi refresh token xoay vòng — 30 ngày.
AW_REFRESH_TOKEN_TTL_SECONDS=2592000

# Refresh token đi bằng cookie httpOnly, không bao giờ nằm trong body JSON —
# nếu nằm trong body, client trình duyệt buộc phải cất nó ở nơi JavaScript đọc
# được, và một lỗ XSS là mất phiên (§38).
#
# `Secure` được bật tự động ở mọi môi trường khác `local`.
AW_REFRESH_COOKIE_NAME=aw_refresh
# Giới hạn phạm vi gửi cookie, giảm bề mặt CSRF.
AW_REFRESH_COOKIE_PATH=/v1/auth
# `lax` đủ khi frontend và API cùng site (app.example.com + api.example.com).
# Khác site thật sự thì phải đổi thành `none`, và khi đó bắt buộc có HTTPS.
AW_REFRESH_COOKIE_SAMESITE=lax
# Để trống khi chạy cục bộ. Production đặt `.example.com` nếu cần chia sẻ
# cookie giữa các subdomain.
# AW_REFRESH_COOKIE_DOMAIN=

# Khoá gốc cho envelope encryption của credential provider (§21).
# Ở local dùng khoá tĩnh cho tiện. Ở production PHẢI thay bằng KMS/Vault —
# xem app/core/crypto.py.
#     python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AW_KMS_PROVIDER=local
AW_KMS_LOCAL_MASTER_KEY=thay-doi-truoc-khi-dung-that

# ─── Model Gateway (§5.2) ────────────────────────────────────────────────────
AW_ANTHROPIC_API_KEY=
AW_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5

AW_OPENAI_API_KEY=
AW_OPENAI_DEFAULT_MODEL=gpt-5.4-mini
