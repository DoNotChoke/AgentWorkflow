{
  "schema_version": "1.0",
  "tool_id": "notion.create_page",
  "provider": "notion",
  "version": "2.0",
  "description": "Tạo một trang mới bên trong một trang Notion có sẵn. Cần id của trang cha — lấy từ notion.search — và trang cha phải nằm trong số những trang người dùng đã chia sẻ với integration. Truyền blocks để viết luôn nội dung; mỗi phần tử là một khối, chọn kiểu bằng type. Không tạo được trang trong database bằng tool này.",
  "input_schema": {
    "version": "2.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_page_id", "title"],
      "properties": {
        "parent_page_id": {
          "type": "string",
          "description": "Id trang cha, 32 ký tự hex có hoặc không có dấu gạch nối.",
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "blocks": {
          "type": "array",
          "description": "Nội dung trang, theo đúng thứ tự. Bỏ trống thì tạo trang rỗng.",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/block" }
        }
      },
      "$defs": {
        "block": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {
              "description": "Kiểu khối. bulleted_list_item là gạch đầu dòng, numbered_list_item là danh sách đánh số, to_do là ô tích, toggle là khối gập được.",
              "enum": [
                "paragraph",
                "heading_1",
                "heading_2",
                "heading_3",
                "bulleted_list_item",
                "numbered_list_item",
                "to_do",
                "toggle",
                "quote",
                "callout"
              ]
            },
            "text": {
              "type": "string",
              "description": "Nội dung khối. Xuống dòng trong cùng một khối thì dùng \n.",
              "minLength": 1,
              "maxLength": 2000
            },
            "checked": {
              "type": "boolean",
              "description": "Chỉ có ý nghĩa với to_do. Bỏ trống thì ô chưa tích."
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" }
      }
    }
  },
  "required_scopes": [],
  "side_effect": "write",
  "retry": {
    "max_attempts": 3,
    "initial_backoff_seconds": 1,
    "max_backoff_seconds": 30,
    "multiplier": 2
  },
  "timeout": { "attempt_seconds": 20, "total_seconds": 60 },
  "rate_limits": { "tool": { "limit": 30, "window_seconds": 60 } },
  "idempotency": {
    "strategy": "dedup_record",
    "required": true,
    "ttl_seconds": 604800
  },
  "permissions": [],
  "approval": { "required": false },
  "request": { "method": "POST", "path": "/pages", "body": "json" },
  "input_mapping": {
    "parent": { "type": "page_id", "page_id": "{{parent_page_id}}" },
    "properties": {
      "title": { "title": [{ "text": { "content": "{{title}}" } }] }
    },
    "children": {
      "for_each": "blocks",
      "template": {
        "object": "block",
        "type": "{{item.type}}",
        "{{item.type}}": {
          "rich_text": [{ "text": { "content": "{{item.text}}" } }],
          "checked": "{{item.checked}}"
        }
      }
    }
  },
  "output_mapping": {
    "id": { "path": ["id"] },
    "url": { "path": ["url"] }
  },
  "provider_reference": { "paths": [["id"]] },
  "enabled": true
}
