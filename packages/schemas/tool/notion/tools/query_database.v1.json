{
  "schema_version": "1.0",
  "tool_id": "notion.query_database",
  "provider": "notion",
  "version": "1.0",
  "description": "Liệt kê các dòng của một database Notion. Trả về id và đường dẫn của từng dòng theo thứ tự mặc định của database; đọc nội dung một dòng bằng notion.get_page với id đó. Lấy id database từ notion.search.",
  "input_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_id"],
      "properties": {
        "database_id": {
          "type": "string",
          "description": "Id database, 32 ký tự hex có hoặc không có dấu gạch nối.",
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
        "start_cursor": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "output_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string" },
              "created_time": { "type": "string" },
              "last_edited_time": { "type": "string" },
              "archived": { "type": "boolean" }
            }
          }
        },
        "next_cursor": { "type": ["string", "null"] },
        "has_more": { "type": "boolean" }
      }
    }
  },
  "required_scopes": [],
  "side_effect": "read",
  "retry": {
    "max_attempts": 3,
    "initial_backoff_seconds": 0.5,
    "max_backoff_seconds": 20,
    "multiplier": 2
  },
  "timeout": { "attempt_seconds": 15, "total_seconds": 60 },
  "rate_limits": { "tool": { "limit": 30, "window_seconds": 60 } },
  "idempotency": { "strategy": "none", "required": false },
  "permissions": [],
  "approval": { "required": false },
  "request": { "method": "POST", "path": "/databases/{database_id}/query", "body": "json" },
  "output_mapping": {
    "results": {
      "path": ["results"],
      "items": {
        "id": ["id"],
        "url": ["url"],
        "created_time": ["created_time"],
        "last_edited_time": ["last_edited_time"],
        "archived": ["archived"]
      }
    },
    "next_cursor": { "path": ["next_cursor"] },
    "has_more": { "path": ["has_more"] }
  },
  "enabled": true
}
