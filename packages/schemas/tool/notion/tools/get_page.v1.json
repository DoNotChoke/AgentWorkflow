{
  "schema_version": "1.0",
  "tool_id": "notion.get_page",
  "provider": "notion",
  "version": "1.0",
  "description": "Đọc thông tin một trang Notion theo id: tiêu đề, đường dẫn, thời điểm tạo và sửa lần cuối. Không trả về nội dung trong trang — dùng notion.get_block_children với cùng id để đọc phần thân. Lấy id từ notion.search.",
  "input_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "description": "Id trang, 32 ký tự hex có hoặc không có dấu gạch nối.",
          "pattern": "^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$"
        }
      }
    }
  },
  "output_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "array",
          "description": "Các đoạn của tiêu đề, ghép lại theo thứ tự thì ra tiêu đề đầy đủ. Vắng mặt với dòng của một database: ở đó tiêu đề nằm dưới tên cột do người dùng đặt chứ không dưới khoá `title`. Phần đuôi của `url` vẫn mang tiêu đề.",
          "items": {
            "type": "string"
          }
        },
        "created_time": {
          "type": "string"
        },
        "last_edited_time": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        },
        "parent_type": {
          "type": "string"
        }
      }
    }
  },
  "required_scopes": [],
  "side_effect": "read",
  "retry": {
    "max_attempts": 3,
    "initial_backoff_seconds": 0.5,
    "max_backoff_seconds": 20,
    "multiplier": 2
  },
  "timeout": {
    "attempt_seconds": 15,
    "total_seconds": 60
  },
  "rate_limits": {
    "tool": {
      "limit": 60,
      "window_seconds": 60
    }
  },
  "idempotency": {
    "strategy": "none",
    "required": false
  },
  "permissions": [],
  "approval": {
    "required": false
  },
  "request": {
    "method": "GET",
    "path": "/pages/{page_id}",
    "body": "query"
  },
  "output_mapping": {
    "id": {
      "path": [
        "id"
      ]
    },
    "url": {
      "path": [
        "url"
      ]
    },
    "title": {
      "path": [
        "properties",
        "title",
        "title",
        "*",
        "plain_text"
      ]
    },
    "created_time": {
      "path": [
        "created_time"
      ]
    },
    "last_edited_time": {
      "path": [
        "last_edited_time"
      ]
    },
    "archived": {
      "path": [
        "archived"
      ]
    },
    "parent_type": {
      "path": [
        "parent",
        "type"
      ]
    }
  },
  "enabled": true
}
