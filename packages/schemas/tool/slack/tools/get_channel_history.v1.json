{
  "schema_version": "1.0",
  "tool_id": "slack.get_channel_history",
  "provider": "slack",
  "version": "1.0",
  "description": "Đọc các tin nhắn gần nhất của một kênh Slack, mới nhất trước. Nhận id kênh chứ không nhận tên. Dùng khi cần tóm tắt một cuộc trao đổi hoặc tìm lại điều đã được nói trong kênh.",
  "input_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel"],
      "properties": {
        "channel": { "type": "string", "pattern": "^[CGD][A-Z0-9]{2,}$" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "cursor": { "type": "string", "maxLength": 512 },
        "oldest": {
          "type": "string",
          "description": "Chỉ lấy tin nhắn sau dấu thời gian này.",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "latest": {
          "type": "string",
          "description": "Chỉ lấy tin nhắn trước dấu thời gian này.",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      }
    }
  },
  "output_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ts": { "type": "string" },
              "user": { "type": "string" },
              "text": { "type": "string" },
              "type": { "type": "string" },
              "thread_ts": { "type": "string" }
            }
          }
        },
        "has_more": { "type": ["boolean", "null"] },
        "next_cursor": { "type": ["string", "null"] }
      }
    }
  },
  "required_scopes": ["channels:history"],
  "side_effect": "read",
  "retry": {
    "max_attempts": 3,
    "initial_backoff_seconds": 0.5,
    "max_backoff_seconds": 20,
    "multiplier": 2
  },
  "timeout": { "attempt_seconds": 20, "total_seconds": 90 },
  "rate_limits": { "tool": { "limit": 50, "window_seconds": 60 } },
  "idempotency": { "strategy": "none", "required": false },
  "permissions": [],
  "approval": { "required": false },
  "request": { "method": "GET", "path": "/conversations.history", "body": "query" },
  "output_mapping": {
    "messages": {
      "path": ["messages"],
      "items": {
        "ts": ["ts"],
        "user": ["user"],
        "text": ["text"],
        "type": ["type"],
        "thread_ts": ["thread_ts"]
      }
    },
    "has_more": { "path": ["has_more"] },
    "next_cursor": { "path": ["response_metadata", "next_cursor"] }
  },
  "enabled": true
}
