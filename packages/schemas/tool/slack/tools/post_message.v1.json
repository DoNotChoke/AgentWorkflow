{
  "schema_version": "1.0",
  "tool_id": "slack.post_message",
  "provider": "slack",
  "version": "1.0",
  "description": "Gửi một tin nhắn văn bản vào một kênh Slack. Nhận id kênh (ví dụ C0123ABCD) chứ không nhận tên kênh — dùng slack.list_channels để đổi tên thành id trước. Trả về dấu thời gian của tin nhắn, thứ dùng để trả lời trong luồng hoặc để xoá sau này.",
  "input_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "text"],
      "properties": {
        "channel": {
          "type": "string",
          "description": "Id kênh, không phải tên kênh.",
          "pattern": "^[CGD][A-Z0-9]{2,}$"
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "thread_ts": {
          "type": "string",
          "description": "Trả lời trong luồng của tin nhắn có dấu thời gian này.",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "output_schema": {
    "version": "1.0",
    "json_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "message_ts"],
      "properties": {
        "channel_id": { "type": "string" },
        "message_ts": { "type": "string" }
      }
    }
  },
  "required_scopes": ["chat:write"],
  "side_effect": "write",
  "retry": {
    "max_attempts": 3,
    "initial_backoff_seconds": 1,
    "max_backoff_seconds": 30,
    "multiplier": 2
  },
  "timeout": { "attempt_seconds": 15, "total_seconds": 60 },
  "rate_limits": { "tool": { "limit": 60, "window_seconds": 60 } },
  "idempotency": {
    "strategy": "dedup_record",
    "required": true,
    "ttl_seconds": 604800
  },
  "permissions": [],
  "approval": { "required": false },
  "request": { "method": "POST", "path": "/chat.postMessage", "body": "json" },
  "output_mapping": {
    "channel_id": { "path": ["channel"] },
    "message_ts": { "path": ["ts"] }
  },
  "provider_reference": {
    "paths": [["channel"], ["ts"]],
    "separator": ":"
  },
  "enabled": true
}
